# CLI / 로컬 동기화용 환경변수 예시
# 사용법:
#   1) copy .env.example .env
#   2) KOSIS_API_KEY= 뒤에 키 붙여넣기
#   3) python KOSIS_Database_Creation_Code/make_database.py --core-only
#
# .env 는 Git에 올리지 마세요. finfit_youth.config 가 자동으로 읽습니다.

KOSIS_API_KEY=

# 선택
# KOSIS_API_BASE=https://kosis.kr/openapi
# GUNSAN_STATS_DB_PATH=gunsan_youth_data.db
# GUNSAN_STATS_SYNC_TTL_SECONDS=604800

# 온통청년 (선택)
# YOUTH_API_KEY=
# YOUTH_CENTER_API_KEY=
# YOUTH_CONTENT_API_KEY=
